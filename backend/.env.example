# Copy to backend/.env. Never put these values in the frontend.
GEMINI_API_KEY=
# Choose a model available to your Google AI Studio project.
GEMINI_MODEL=gemini-3.8-flash
# Origins have no path and no trailing slash; comma-separated.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CHAT_RATE_LIMIT=10 per minute
# memory:// is sufficient for local development; use Redis for shared limits.
RATELIMIT_STORAGE_URI=memory://
